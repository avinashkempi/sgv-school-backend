# ===== REQUIRED — Server will crash without these =====

# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT secret for auth tokens — use a strong random string
JWT_SECRET=your-secret-key-here

# ===== OPTIONAL — Defaults shown =====

# Server port (default: 10000)
PORT=10000

# Node environment
NODE_ENV=development

# Firebase Configuration (for push notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_CLIENT_EMAIL=your-client-email

# ===== Google Sheets Fee Sync (for automated fee updates) =====

# Spreadsheet ID from the Google Sheets URL
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Tab/Sheet name containing student fee data
GOOGLE_SHEETS_TAB_NAME=students

# Service Account credentials (from Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Enable/disable automated fee sync (set to 'true' to enable)
FEE_SYNC_ENABLED=false
